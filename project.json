{
    "id": "sireflect",
    "type": "package",
    "value": {
        "author": "Suleyman Laarabi",
        "description": "Lightweight runtime reflection, serialization and deserialization library for modern C23.",
        "language": "c",
        "clangd": true,
        "amalgamate": [
          {
            "path": "distr"
          }
        ]
    },
    "lang.c": {
      "c-standard": "c23",
      "${os windows}": {
        "c-standard": "c11",
        "symbols": false,
        "cflags": ["/FS"]
      },
      "export-symbols": true,
      "include": ["src"]
    }
}
