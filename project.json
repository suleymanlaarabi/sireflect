{
    "id": "sireflect",
    "type": "package",
    "value": {
        "author": "Suleyman Laarabi",
        "description": "Lightweight runtime reflection, serialization and deserialization library for modern C23.",
        "language": "c",
        "clangd": true,
        "use": ["sicore"],
        "amalgamate": [
          {
            "path": "distr",
            "dependencies": true
          }
        ]
    },
    "bundle": {
      "repositories": {
        "sicore": "https://github.com/suleymanlaarabi/sicore"
      }
    },
    "lang.c": {
      "c-standard": "c17",
      "${os windows}": {
        "c-standard": "c11",
        "symbols": false,
        "cflags": ["/FS"]
      },
      "export-symbols": true,
      "include": ["src"]
    }
}
